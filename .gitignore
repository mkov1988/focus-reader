# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Heavy design assets — kept local, not needed in the repo
docs/UI Inspo/
docs/assets/references/

# Stray package tarballs / extracted packages
*.tgz
/package/

# Mirrored book covers — a local build artifact from `npm run mirror:covers`.
# Served same-origin from /covers and bundled into the build (or uploaded to a
# CDN via VITE_COVER_BASE). Regenerated, so not committed.
/public/covers/
/covers/

# Mirrored book text — a local build artifact from `npm run mirror:books`.
# Served same-origin from /books (or a CDN via VITE_BOOK_BASE). Large and
# regenerated, so not committed.
/public/books/

# Full-catalog bulk mirror (scripts/crawl-catalog.mjs + scripts/mirror-all.mjs).
# ~19GB / 55,863 files (measured post quality gate) destined for bucket storage
# (R2), never for the repo or the Pages build.
/mirror/

# Resumable cache for the word-count crawler (scripts/add-vibe-wordcounts.mjs).
scripts/.vibe-wordcounts.json

# Lint run artifact
lint_output.txt

# Demo password file (never commit credentials)
.demo-pass.txt

# R2 bucket credentials (never commit; see docs/SERVING.md for the upload flow)
.r2.env

# Deep-pass working area. Queues, raw agent results, and caches are regenerable
# scratch and stay ignored. The FINISHED stores and the workflow scripts that
# produced them ARE committed: they are the only copy of the 800-book deep read
# and must survive a disk loss. Do not widen this ignore back to the whole dir.
/scripts/deep-starts/*
!/scripts/deep-starts/meta.json
!/scripts/deep-starts/details.json
!/scripts/deep-starts/snippets.json
!/scripts/deep-starts/deep-scenes.json
!/scripts/deep-starts/verified.json
!/scripts/deep-starts/non-narrative.json
!/scripts/deep-starts/done.json
!/scripts/deep-starts/deep-pass-done.json
!/scripts/deep-starts/redo-done.json
!/scripts/deep-starts/deep-pass-results/
!/scripts/deep-starts/*.mjs
!/scripts/deep-starts/.verify-workflow.js

# Generated triage/scratch artifacts from the story-start + recap pipelines.
scripts/.story-starts-report.json
scripts/.recap-batch-*.json

# Resweep run report (regenerated by scripts/resweep-trademark.mjs).
scripts/.resweep-report.json
