# Immutable content: a Gutenberg id's text and cover never change, and
# starts-v1.json is versioned by filename (a re-verification ships v2, never a
# mutated v1). Long-lived caching is the designed contract; the R2 door in
# functions/books/[id].js sets the same header for long-tail books.
/books/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/covers/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/starts-v1.json
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/modernity-v1.json
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/narration-v1.json
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Key-idea summaries are editorial content that can be revised or pulled, so
# they are deliberately NOT immutable: the short cache on the manifest is the
# kill switch (scripts/summaries/build.mjs --hide), and texts cache for a day.
/summaries/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/summaries-v1.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
