+/**
+ * Pins the narration follower's sync math (src/reader/narrationSync.ts): the
+ * reel-clock expectation that makes drift measurement immune to a late JS
+ * listener, and the nudge-first correction that keeps seeks (audible: a
+ * repeated or clipped word) for real jumps. Same TS-transpile technique as
+ * test-tokenize.mjs; no device, no player.
+ *
+ *   node scripts/test-narration-sync.mjs
+ */
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function loadTsModule(rel) {
+    const src = readFileSync(path.join(ROOT, rel), 'utf8');
+    const js = ts.transpileModule(src, {
+        compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 },
+    }).outputText;
+    const module = { exports: {} };
+    new Function('require', 'module', 'exports', js)(require, module, module.exports);
+    return module.exports;
+}
+
+const sync = loadTsModule('src/reader/narrationSync.ts');
+let failures = 0;
+const check = (label, cond, detail = '') => {
+    if (cond) console.log(`ok  ${label}`);
+    else { console.error(`FAIL ${label} ${detail}`); failures++; }
+};
+
+// ── 1. Segment tables ───────────────────────────────────────────────────────
+{
+    const timing = {
+        v: 1, bookId: '1', voice: 'marlowe', naturalWpm: 200, span: [10, 15],
+        segments: [
+            { file: 'seg-000.opus', startWord: 10, words: 3, durMs: 900, bytes: 1 },
+            { file: 'seg-001.opus', startWord: 13, words: 3, durMs: 1200, bytes: 1 },
+        ],
+        durCs: [20, 30, 40, 50, 30, 40],
+    };
+    const starts = sync.buildSegmentStarts(timing);
+    check('starts: per segment, ms, from 0', JSON.stringify(starts) === '[[0,200,500],[0,500,800]]', JSON.stringify(starts));
+    check('segmentForIndex: inside / boundary / outside', sync.segmentForIndex(timing, 10) === 0 && sync.segmentForIndex(timing, 12) === 0 && sync.segmentForIndex(timing, 13) === 1 && sync.segmentForIndex(timing, 16) === -1 && sync.segmentForIndex(timing, 9) === -1);
+}
+
+// ── 2. The reel-clock expectation ───────────────────────────────────────────
+// A word committed at recording start 4.00 s while the reel runs at 2.0×.
+// The JS thread hears about the commit 120 ms late; the player, in perfect
+// step with the reel, is by then at 4.24 s.
+{
+    const startMs = 4000;
+    const reelRate = 2.0;
+    const lateMs = 120;
+    const playerNow = 4.0 + (lateMs / 1000) * reelRate;
+    const naive = playerNow - startMs / 1000;
+    check('late listener: comparing against the word START reads its own lag as drift (the old bug)', Math.abs(naive - 0.24) < 1e-9, `${naive}`);
+    const clocked = playerNow - sync.expectedSeconds(startMs, lateMs, reelRate);
+    check('late listener: comparing against the reel CLOCK reads zero drift', Math.abs(clocked) < 1e-9, `${clocked}`);
+    check('expectedSeconds: no elapsed = the word start', sync.expectedSeconds(startMs, 0, reelRate) === 4);
+}
+
+// ── 3. planCorrection ───────────────────────────────────────────────────────
+{
+    const base = 1.5;
+    const s0 = sync.initialFollowerState();
+    const plan = (d, b = base, st = s0, dt = 1, force = false) => sync.planCorrection(d, b, st, dt, force);
+    check('forced (a jump) is a seek whatever the drift', plan(0, base, s0, 1, true).correction.kind === 'seek');
+    check('gross drift is a seek', plan(sync.HARD_SEEK_S + 0.01).correction.kind === 'seek' && plan(-(sync.HARD_SEEK_S + 0.01)).correction.kind === 'seek');
+    check('a seek leaves the learned bias alone', plan(2, base, { bias: 0.04 }).state.bias === 0.04);
+    check('drift at the threshold still nudges', plan(sync.HARD_SEEK_S).correction.kind === 'rate');
+    const ahead = plan(0.1).correction;
+    const behind = plan(-0.1).correction;
+    check('voice ahead → slower; behind → faster; by KP × drift in recording seconds, whatever the rate',
+        ahead.kind === 'rate' && behind.kind === 'rate'
+        && Math.abs(ahead.rate - (base - 0.1 * sync.NUDGE_KP)) < 1e-9
+        && Math.abs(behind.rate - (base + 0.1 * sync.NUDGE_KP)) < 1e-9
+        && Math.abs(plan(0.1, 0.5).correction.rate - (0.5 - 0.1 * sync.NUDGE_KP)) < 1e-9);
+    const capped = plan(0.7).correction;
+    check('nudge is capped at ±15% of the rate', capped.kind === 'rate' && Math.abs(capped.rate - base * (1 - sync.NUDGE_MAX)) < 1e-9);
+    check('in step with no bias → exactly the base rate', plan(0).correction.rate === base);
+    check('the bias runs the player slower by itself (a learned reel lag)', Math.abs(plan(0, base, { bias: 0.04 }).correction.rate - base * 0.96) < 1e-9);
+    check('bias learns from drift, scaled by dt', Math.abs(plan(0.1, base, s0, 1).state.bias - (sync.NUDGE_KI / base) * 0.1) < 1e-9
+        && Math.abs(plan(0.1, base, s0, 2).state.bias - 2 * (sync.NUDGE_KI / base) * 0.1) < 1e-9);
+    check('dt is clamped to a sane check interval', Math.abs(plan(0.1, base, s0, 60).state.bias - 3 * (sync.NUDGE_KI / base) * 0.1) < 1e-9);
+    const pinned = plan(0.7, base, { bias: sync.NUDGE_MAX });
+    check('anti-windup: pinned at the cap, the bias stops growing', pinned.state.bias === sync.NUDGE_MAX);
+    const unwinding = plan(-0.7, base, { bias: sync.NUDGE_MAX });
+    check('anti-windup: pinned but drift reversed, the bias unwinds', unwinding.state.bias < sync.NUDGE_MAX);
+    const top = plan(-0.5, 2.0).correction;
+    check('faster never exceeds the player ceiling', top.kind === 'rate' && top.rate === sync.MAX_RATE);
+    check('rate floor follows the slowest reader on the fastest voice (100 / 233 wpm)', sync.clampRate(100 / 233) > sync.MIN_RATE && sync.clampRate(100 / 233) < 0.5);
+}
+
+// ── 4. Closed loop: the reel's frame-quantized lag never earns a seek ───────
+// The engine drops the accumulator's overshoot on every word (half a frame:
+// ~8 ms at 60 Hz, ~17 ms at a struggling 30 Hz), so the reel runs a few
+// percent slower than the voice. Once a second the follower measures and
+// corrects. Model in recording seconds: the voice advances at the applied
+// rate — the player only takes a new rate once its processed audio drains,
+// so the first `actuatorLag` of each second still runs at the previous rate —
+// and the reel at (1 − lag) × reel rate. Measurements carry ±20 ms of noise
+// (frame quantization of the clock, position granularity of the player).
+function run({ base, lagFrac, seconds, kick = 0, actuatorLag = 0.75, noise = 0.02, lagStep = null }) {
+    let drift = kick;
+    let state = sync.initialFollowerState();
+    let prevRate = base;
+    let seeks = 0;
+    let maxAbs = Math.abs(drift);
+    let maxAfter12 = 0;
+    let settleAt = null;
+    let lag = lagFrac;
+    for (let t = 1; t <= seconds; t++) {
+        if (lagStep && t === lagStep.t) lag = lagStep.lagFrac;
+        const measured = drift + (Math.random() - 0.5) * 2 * noise;
+        const r = sync.planCorrection(measured, base, state, 1);
+        state = r.state;
+        let rate;
+        if (r.correction.kind === 'seek') { seeks++; drift = -0.1; rate = base; } // a seek lands ~100 ms behind (pipeline restart)
+        else rate = r.correction.rate;
+        const applied = prevRate * actuatorLag + rate * (1 - actuatorLag);
+        prevRate = rate;
+        drift += applied - base * (1 - lag);
+        maxAbs = Math.max(maxAbs, Math.abs(drift));
+        if (t > 12) maxAfter12 = Math.max(maxAfter12, Math.abs(drift));
+        if (settleAt === null && Math.abs(drift) < 0.05) settleAt = t;
+    }
+    return { drift: +drift.toFixed(3), seeks, maxAbs: +maxAbs.toFixed(3), maxAfter12: +maxAfter12.toFixed(3), settleAt, bias: +state.bias.toFixed(3) };
+}
+{
+    const r60 = run({ base: 1.5, lagFrac: 0.04, seconds: 600 });
+    check('60 Hz reel lag, 1.5×: ten minutes, no seeks, drift held under 60 ms once settled', r60.seeks === 0 && r60.maxAfter12 < 0.06, JSON.stringify(r60));
+    const r30 = run({ base: 2.0, lagFrac: 0.085, seconds: 600 });
+    check('30 Hz reel lag at the 2.0× ceiling: no seeks, drift under 60 ms once settled, bias learned', r30.seeks === 0 && r30.maxAfter12 < 0.06 && Math.abs(r30.bias - 0.085) < 0.02, JSON.stringify(r30));
+    const slow = run({ base: 0.43, lagFrac: 0.02, seconds: 300 });
+    check('100 WPM on the fastest voice (0.43×): no seeks, in step', slow.seeks === 0 && slow.maxAbs < 0.06, JSON.stringify(slow));
+    // A WPM tap restarts the word on screen (engine parity), so the voice is
+    // suddenly ahead by however far into the word it was — a typical 0.4 s.
+    const tap = run({ base: 1.2, lagFrac: 0.04, seconds: 30, kick: 0.4 });
+    check('WPM tap mid-word: walked back under 50 ms within 12 s, no seek', tap.seeks === 0 && tap.settleAt !== null && tap.settleAt <= 12, JSON.stringify(tap));
+    const faster = run({ base: 1.0, lagFrac: 0.03, seconds: 120, lagStep: { t: 40, lagFrac: 0.06 } });
+    check('reel lag doubles mid-read (a faster WPM): re-learned without a seek', faster.seeks === 0 && faster.maxAbs < 0.15 && Math.abs(faster.bias - 0.06) < 0.02, JSON.stringify(faster));
+    const behind = run({ base: 0.5, lagFrac: 0.02, seconds: 30, kick: -0.3 });
+    check('voice behind after a segment swap: caught up without a seek', behind.seeks === 0 && behind.settleAt !== null && behind.settleAt <= 12, JSON.stringify(behind));
+    // The old follower under the same 60 Hz lag: seek-only, 0.25 s tolerance,
+    // measured against the word start by a listener ~120 ms late at 2.0×.
+    let oldSeeks = 0;
+    let oldDrift = 0;
+    for (let t = 1; t <= 60; t++) {
+        const measured = oldDrift + 0.12 * 2.0;
+        if (Math.abs(measured) > 0.25) { oldSeeks++; oldDrift = -0.1; }
+        oldDrift += 2.0 * 0.04;
+    }
+    check('the old seek-only check under a 120 ms late listener rewound the voice every check or two (the reported stutter)', oldSeeks >= 25, `${oldSeeks}/60`);
+}
+
+console.log('');
+if (failures) { console.error(`${failures} failure(s).`); process.exit(1); }
+console.log('narration sync contracts hold.');
