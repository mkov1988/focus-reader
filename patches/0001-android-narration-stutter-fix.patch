  */
 import { useEffect, useRef, useState } from 'react';
 import { createAudioPlayer, setAudioModeAsync, type AudioPlayer } from 'expo-audio';
 import type { ParsedText } from '../textProcessing';
 import { ensureSegment, fetchNarrationTiming, getNarrationInfo, type NarrationTiming } from '../services/narration';
+import type { ReelClock } from './useReelEngine';
+import { MAX_RATE, buildSegmentStarts, clampRate, expectedSeconds, initialFollowerState, planCorrection, segmentForIndex, type FollowerState } from './narrationSync';
 
 /** The narration ceiling (owner decision, 2026-08-22): voice follows to 400
  *  WPM, mutes above, rejoins below. The Lane B master is synthesized at ~200
  *  WPM natural precisely so 400 lands on the 2.0× rate cap. */
 export const MUTE_WPM = 400;
-const MIN_RATE = 0.5;
-const MAX_RATE = 2.0;
-const DRIFT_TOLERANCE_S = 0.25;
