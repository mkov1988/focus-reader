+/**
+ * Narration sync math — the pure half of useNarrationAudio, free of React and
+ * expo-audio so scripts/test-narration-sync.mjs can pin it.
+ *
+ * Vocabulary. "Recording seconds" is the master's own timeline, what the
+ * player's currentTime reports. The "reel rate" is recording seconds per wall
+ * second at the reader's WPM: wpm / naturalWpm, unclamped — it is what the
+ * reel does whether or not the player can follow. "Drift" is player position
+ * minus where the reel's clock says the voice should be, in recording
+ * seconds, positive when the voice is ahead.
+ */
+import type { NarrationTiming } from '../services/narration';
+
+/** ExoPlayer's pitch-corrected range is 0.1×–2.0×. The floor sits at 0.25 so
+ *  a 100 WPM reader stays in step with the shelf's fastest voice (naturalWpm
+ *  ≈ 233 → 0.43×); pinned at 0.5× the voice ran 16% ahead of the reel and the
+ *  corrector rewound it every couple of seconds. */
+export const MIN_RATE = 0.25;
+export const MAX_RATE = 2.0;
+
+/** Inside HARD_SEEK_S the correction is a rate nudge — pitch corrected and at
+ *  most ±15%, it is inaudible, where a seek is a repeated or clipped word.
+ *  Beyond it (a scrub, a sentence skip, a WPM tap deep into a long word) a
+ *  nudge would take seconds to close and one seek is the lesser evil.
+ *
+ *  The nudge is proportional-integral. KP is the fraction of the measured
+ *  drift closed per second, in recording seconds — NOT a fraction of the
+ *  rate, so the loop gain is the same at 0.5× and 2.0×. KI feeds a learned
+ *  BIAS: the reel drops the accumulator's overshoot on every word (about half
+ *  a frame), so it runs a steady few percent slower than its nominal rate,
+ *  and the bias absorbs that so the voice settles ON the reel rather than a
+ *  fixed distance ahead of it. Both are deliberately soft: the check runs
+ *  about once a second and the player applies a new rate only after the
+ *  audio it has already processed drains (up to most of a second), and these
+ *  values stay well damped under that delay while a snappier pair rings. */
+export const HARD_SEEK_S = 0.8;
+export const NUDGE_KP = 0.6;
+export const NUDGE_KI = 0.15;
+export const NUDGE_MAX = 0.15;
+
+export const clampRate = (rate: number): number => Math.min(MAX_RATE, Math.max(MIN_RATE, rate));
+
+/** Per-segment word start times (ms into that segment's audio), derived once
+ *  from the flat durCs list. */
+export function buildSegmentStarts(timing: NarrationTiming): number[][] {
+    const out: number[][] = [];
+    let k = 0;
+    for (const seg of timing.segments) {
+        const starts = new Array<number>(seg.words);
+        let at = 0;
+        for (let w = 0; w < seg.words; w++) {
+            starts[w] = at;
+            at += timing.durCs[k++] * 10;
+        }
+        out.push(starts);
+    }
+    return out;
+}
+
+export function segmentForIndex(timing: NarrationTiming, index: number): number {
+    for (let s = 0; s < timing.segments.length; s++) {
+        const seg = timing.segments[s];
+        if (index >= seg.startWord && index < seg.startWord + seg.words) return s;
+    }
+    return -1;
+}
+
+/** Where the voice should be right now, in recording seconds: the committed
+ *  word's start plus the reel's own progress through it. The progress term is
+ *  the whole point — a listener that only knows the word's start reads its own
+ *  lateness as drift (see useNarrationAudio). */
+export function expectedSeconds(wordStartMs: number, elapsedMs: number, reelRate: number): number {
+    return (wordStartMs + elapsedMs * reelRate) / 1000;
+}
+
+export type Correction = { kind: 'seek' } | { kind: 'rate'; rate: number };
+
+/** The follower's memory between checks: the reel's learned steady lag as a
+ *  fraction of the reel rate (positive = the reel runs slower than nominal). */
+export interface FollowerState {
+    bias: number;
+}
+export const initialFollowerState = (): FollowerState => ({ bias: 0 });
+
+/** What to do about a measured drift: seek when forced (a real jump) or when
+ *  gross, otherwise the playback rate that walks it back. `dtS` is the time
+ *  since the previous check (the integral's step). Returns the next state —
+ *  unchanged across a seek, since a seek says nothing about the reel's pace. */
+export function planCorrection(
+    driftS: number,
+    baseRate: number,
+    state: FollowerState,
+    dtS: number,
+    force = false,
+): { correction: Correction; state: FollowerState } {
+    if (force || Math.abs(driftS) > HARD_SEEK_S) return { correction: { kind: 'seek' }, state };
+    const dt = Math.min(3, Math.max(0.5, dtS));
+    // Everything below is in rate fractions: rate = baseRate × (1 + u).
+    const raw = -(NUDGE_KP / baseRate) * driftS - state.bias;
+    const u = Math.max(-NUDGE_MAX, Math.min(NUDGE_MAX, raw));
+    // Clamping anti-windup: keep learning unless the output is already
+    // pinned at the cap and this step would only pin it harder.
+    const saturated = Math.abs(raw) > NUDGE_MAX;
+    const bias = !saturated || driftS * raw > 0
+        ? Math.max(-NUDGE_MAX, Math.min(NUDGE_MAX, state.bias + (NUDGE_KI / baseRate) * driftS * dt))
+        : state.bias;
+    return { correction: { kind: 'rate', rate: clampRate(baseRate * (1 + u)) }, state: { bias } };
+}
