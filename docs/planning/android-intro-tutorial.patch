new file mode 100644
index 0000000..7a896f0
--- /dev/null
+++ b/src/intro.ts
@@ -0,0 +1,190 @@
+/**
+ * The intro — "Your first read", the tutorial a fresh install meets in the
+ * Today hero slot (where the resume card normally sits). It is a tiny
+ * bundled "book" (tier 0 of the fetch ladder, see bundledBooks.ts) whose
+ * text is about the very thing happening on screen: the reader opens it at
+ * 200 words per minute and ramps to 300 while the copy talks the reader
+ * through it, then hands the controls over.
+ *
+ * The ramp is defined in WORD space, not wall-clock time, so the copy and the
+ * speed can never drift apart: each segment names the speed at its first word
+ * and the speed it has reached by the time the next segment begins,
+ * interpolated linearly per word between them. Pausing or scrubbing simply
+ * pauses or rewinds the ramp. The reader turns this curve into the engine's
+ * per-word pacing override (ReaderScreen), so the reel engine itself is
+ * untouched — and the intro never writes the reader's own WPM setting.
+ *
+ * Segment texts are tokenized here with EXACTLY parseText's rule (whitespace
+ * split after blank lines become the [P] marker, which is not a token), so the
+ * keyframe indexes line up with the reader's token ids. scripts/test-intro.mjs
+ * pins that equivalence and the ramp's timing.
+ */
+import type { BookMeta } from './services/gutenberg';
+
+export const INTRO_BOOK_ID = 'intro';
+
+export const INTRO_BOOK: BookMeta = {
+    id: INTRO_BOOK_ID,
+    title: 'Your first read',
+    author: 'Focus Reader',
+    downloads: 0,
+};
+
+/** The Today card's italic one-liner, and its length line under the title.
+ *  The whole intro runs about 86 s on the reader's clock (scripts/test-intro.mjs
+ *  prints the beats), so both lines say a minute and a half. */
+export const INTRO_BLURB = 'Ninety seconds, one letter, and a small unearned sense of superiority.';
+export const INTRO_LENGTH_LABEL = 'About a minute and a half';
+
+/** Speed the intro starts at, and the speed it leaves the reader on. */
+export const INTRO_START_WPM = 200;
+export const INTRO_END_WPM = 300;
+
+export interface IntroSegment {
+    /** Paragraphs separated by blank lines, like any book text. */
+    text: string;
+    /** Words per minute at this segment's first word … */
+    from: number;
+    /** … climbing linearly to this by the segment's end, so the NEXT
+     *  segment's first word is the first word read at `to`. */
+    to: number;
+}
+
+// Four beats, in order: hold at 200 · ramp to 300 · the payoff at 300 · the
+// controls handoff at 300 (the first word of that last beat is where the
+// chrome tucks away and the speed pill lights up — see ReaderScreen).
+export const INTRO_SEGMENTS: IntroSegment[] = [
+    {
+        from: INTRO_START_WPM, to: INTRO_START_WPM,
+        text: `Hello, and welcome.
+
+Keep your eyes on the coloured letter. It sits near the middle of every word, so your eyes never have to move. The words come to you.
+
+Right now you are reading at 200 words per minute. Comfortable, yes?`,
+    },
+    {
+        from: INTRO_START_WPM, to: INTRO_END_WPM,
+        text: `Nothing to do here but stay with the letter and let the words arrive.
+
+Most of us learned to read by moving our eyes along a line, back and forth, line after line. That is slow, and a little tiring. Here the line comes to you instead, one word at a time, and your eyes get to sit still for once.
+
+The pace has been creeping up for a little while now. You may not have noticed, and that is rather the point. If a word slips past, let it go. The next one is already here.
+
+Breathe. Blink if you like. Nearly there.`,
+    },
+    {
+        from: INTRO_END_WPM, to: INTRO_END_WPM,
+        text: `And there it is. You started at 200. You are now reading at 300 words a minute.
+
+The average adult manages about 240. Somewhere in the last half minute, you quietly became faster than average. Not bad for a first go.
+
+See how cool this app is? Take a bow. Nobody is watching.`,
+    },
+    {
+        from: INTRO_END_WPM, to: INTRO_END_WPM,
+        text: `There go the controls, tucking themselves away. And the minus and plus on the speed pill lit up as they went. They are yours now.
+
+Tap this word to pause. Tap anywhere else to bring the controls back. Drag the word up or down to scrub through the book. Below the word, swipe sideways to skip a sentence, or swipe down to leave. The pill sets your speed.
+
+The shelf is waiting on the home screen. Go and pick a book. It will not read itself. Well, this one did.`,
+    },
+];
+
+/** parseText's tokenizer, minus the token objects: how many words a text
+ *  yields. Keep in lockstep with textProcessing.parseText. */
+function countTokens(text: string): number {
+    const marked = text.replace(/\r\n?/g, '\n').replace(/\n[ \t]*\n+/g, ' [P] ');
+    const trimmed = marked.trim();
+    if (!trimmed) return 0;
+    return trimmed.split(/\s+/).filter((w) => w !== '[P]').length;
+}
+
+export interface IntroKeyframe {
+    /** Token index. */
+    index: number;
+    wpm: number;
+}
+
+export interface IntroPlan {
+    /** The whole tutorial as one book text. */
+    text: string;
+    /** Total token count parseText will produce for `text`. */
+    tokenCount: number;
+    /** Speed at each segment's first and last word, in token space. */
+    keyframes: IntroKeyframe[];
+    /** First token of the payoff beat — the ramp lands on INTRO_END_WPM here. */
+    rampEnd: number;
+    /** First token of the handoff beat — chrome unpins, speed pill unlocks,
+     *  and the reader's own WPM takes over from here on. */
+    handoff: number;
+}
+
+function buildPlan(segments: IntroSegment[]): IntroPlan {
+    const keyframes: IntroKeyframe[] = [];
+    const starts: number[] = [];
+    let index = 0;
+    for (const seg of segments) {
+        const n = countTokens(seg.text);
+        starts.push(index);
+        if (n > 0) {
+            keyframes.push({ index, wpm: seg.from });
+            // `to` lands on the word AFTER this segment (the next one's first
+            // word), so a payoff beat's opening word is the first at its speed.
+            keyframes.push({ index: index + n, wpm: seg.to });
+        }
+        index += n;
+    }
+    return {
+        text: segments.map((s) => s.text.trim()).join('\n\n'),
+        tokenCount: index,
+        keyframes,
+        rampEnd: starts[2] ?? index,
+        handoff: starts[3] ?? index,
+    };
+}
+
+export const INTRO_PLAN: IntroPlan = buildPlan(INTRO_SEGMENTS);
+export const INTRO_TEXT = INTRO_PLAN.text;
+
+/**
+ * The scripted speed for word `index`. Before the handoff it follows the
+ * keyframes (piecewise linear); from the handoff on, `tailWpm` — the speed
+ * the reader has been handed (the intro's own stepper value, seeded at
+ * INTRO_END_WPM) — paces the rest.
+ */
+export function introWpmAt(index: number, tailWpm: number, plan: IntroPlan = INTRO_PLAN): number {
+    if (index >= plan.handoff) return tailWpm;
+    const kf = plan.keyframes;
+    if (kf.length === 0) return tailWpm;
+    if (index <= kf[0].index) return kf[0].wpm;
+    for (let k = 1; k < kf.length; k++) {
+        const a = kf[k - 1];
+        const b = kf[k];
+        if (index <= b.index) {
+            if (b.index === a.index) return b.wpm;
+            const f = (index - a.index) / (b.index - a.index);
+            return a.wpm + (b.wpm - a.wpm) * f;
+        }
+    }
+    return kf[kf.length - 1].wpm;
+}
+
+/**
+ * The engine's per-word pacing override for the intro (the same mechanism
+ * narration uses): the reel engine computes each dwell as
+ * (60000 / storeWpm) × multiplier, so scaling every multiplier by
+ * storeWpm / scriptedWpm makes the dwell exactly (60000 / scriptedWpm) ×
+ * the word's own punctuation multiplier. Past the handoff the scripted speed
+ * is `tailWpm` (the intro's stepper), so the store setting never has to move;
+ * with `handedOff` the whole text follows the stepper.
+ */
+export function introPacing(multipliers: readonly number[], storeWpm: number, tailWpm: number, plan: IntroPlan = INTRO_PLAN, handedOff = false): number[] {
+    const out = new Array<number>(multipliers.length);
+    for (let i = 0; i < multipliers.length; i++) {
+        // Once the speed has been handed over, EVERY word follows the stepper
+        // (scrubbing back into the ramp reads at the pill's number, not 200).
+        const wpm = handedOff ? tailWpm : introWpmAt(i, tailWpm, plan);
+        out[i] = multipliers[i] * (storeWpm / wpm);
+    }
+    return out;
+}
