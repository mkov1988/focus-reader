@@ -0,0 +1,145 @@
+/**
+ * Pins the intro tutorial (src/intro.ts) to the reader it runs in.
+ *
+ * The intro's speed curve lives in WORD space: keyframe token indexes are
+ * computed by intro.ts with its own copy of parseText's whitespace rule. If
+ * the two ever disagree, the "you're now at 300" line lands on the wrong
+ * word. This test transpiles both modules with the repo's TypeScript (the
+ * same trick as test-tokenize.mjs), parses the real text with the real
+ * parser, and checks: the token counts agree; the parse has no front or back
+ * matter clipping (the reader would skip words); the curve starts at 200,
+ * reaches 300 exactly at the payoff word and stays there; the ramp lasts a
+ * sensible ~30 s on the reader's own clock (60000 / wpm × each word's
+ * punctuation multiplier); and the copy obeys the one-word-at-a-time display
+ * rules (no over-long words, no bare punctuation tokens).
+ *
+ *   npm test
+ */
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function loadTsModule(rel, injectedModules = {}) {
+    const src = readFileSync(path.join(ROOT, rel), 'utf8');
+    const js = ts.transpileModule(src, {
+        compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 },
+    }).outputText;
+    const module = { exports: {} };
+    const localRequire = (name) => {
+        if (injectedModules[name]) return injectedModules[name];
+        return require(name);
+    };
+    new Function('require', 'module', 'exports', js)(localRequire, module, module.exports);
+    return module.exports;
+}
+
+const chapterDetection = loadTsModule('src/chapterDetection.ts');
+const tp = loadTsModule('src/textProcessing.ts', { './chapterDetection': chapterDetection });
+const intro = loadTsModule('src/intro.ts');
+
+const { INTRO_PLAN: plan, INTRO_TEXT: text, INTRO_SEGMENTS: segments, INTRO_START_WPM, INTRO_END_WPM } = intro;
+
+let failures = 0;
+const fail = (msg) => { failures++; console.error(`FAIL ${msg}`); };
+const ok = (msg) => console.log(`ok  ${msg}`);
+
+// ── 1. Token space agrees with the real parser ──────────────────────────
+const parsed = tp.parseText(text);
+const n = parsed.tokens.length;
+if (n !== plan.tokenCount) fail(`token count: intro.ts counted ${plan.tokenCount}, parseText produced ${n}`);
+else ok(`token space agrees (${n} words)`);
+
+if (parsed.readableStartWord !== 0 || parsed.readableEndWord !== n - 1) {
+    fail(`readable bounds [${parsed.readableStartWord}, ${parsed.readableEndWord}] would clip the intro (expected [0, ${n - 1}])`);
+} else ok('no front/back matter clipping');
+// Bare numbers or heading-like lines would become chapters: the progress
+// bar would read "Chapter 1: word…" and the scrubber would grow chapter arrows.
+if (parsed.chapters.length > 0) fail(`the copy detects as ${parsed.chapters.length} chapter(s)`);
+else ok('no chapter headings detected');
+
+// ── 2. The curve ────────────────────────────────────────────────────────
+const wpmAt = (i) => intro.introWpmAt(i, INTRO_END_WPM, plan);
+const kf = plan.keyframes;
+for (let k = 1; k < kf.length; k++) {
+    if (kf[k].index < kf[k - 1].index) fail(`keyframes out of order at ${k}`);
+}
+if (kf[0]?.index !== 0 || kf[0]?.wpm !== INTRO_START_WPM) fail(`curve must start at word 0 at ${INTRO_START_WPM} wpm`);
+if (wpmAt(plan.rampEnd) !== INTRO_END_WPM) fail(`payoff word ${plan.rampEnd} is at ${wpmAt(plan.rampEnd)} wpm, expected ${INTRO_END_WPM}`);
+if (!(wpmAt(plan.rampEnd - 1) < INTRO_END_WPM)) fail('the word before the payoff should still be below the final speed');
+for (let i = plan.rampEnd; i < n; i++) {
+    if (wpmAt(i) !== INTRO_END_WPM) { fail(`word ${i} after the payoff is at ${wpmAt(i)} wpm`); break; }
+}
+for (let i = 1; i < plan.rampEnd; i++) {
+    if (wpmAt(i) < wpmAt(i - 1)) { fail(`the curve dips at word ${i}`); break; }
+}
+if (plan.handoff <= plan.rampEnd) fail('the handoff must come after the payoff');
+// The pacing override must reproduce the curve exactly on the engine's clock.
+const mults = parsed.tokens.map((t) => t.delayMultiplier);
+for (const storeWpm of [200, 300, 450]) {
+    for (const tailWpm of [300, 350]) {
+        const pacing = intro.introPacing(mults, storeWpm, tailWpm, plan);
+        for (let i = 0; i < n; i++) {
+            const expected = (60000 / intro.introWpmAt(i, tailWpm, plan)) * mults[i];
+            const got = (60000 / storeWpm) * pacing[i];
+            if (Math.abs(expected - got) > 1e-6) { fail(`pacing override drifts at word ${i} (store ${storeWpm}, tail ${tailWpm})`); break; }
+        }
+    }
+}
+if (intro.introWpmAt(plan.handoff, 350, plan) !== 350 || intro.introWpmAt(plan.handoff - 1, 350, plan) !== INTRO_END_WPM) {
+    fail('the handoff word should be the first paced by the stepper value');
+}
+{
+    // Handed off: every word, ramp included, follows the stepper.
+    const pacing = intro.introPacing(mults, 300, 350, plan, true);
+    for (let i = 0; i < n; i++) {
+        if (Math.abs((60000 / 300) * pacing[i] - (60000 / 350) * mults[i]) > 1e-6) { fail(`after the handoff word ${i} does not follow the stepper`); break; }
+    }
+}
+if (failures === 0) ok(`curve: ${INTRO_START_WPM} → ${INTRO_END_WPM} at word ${plan.rampEnd}, handoff at word ${plan.handoff}`);
+
+// ── 3. Timing on the reader's clock ─────────────────────────────────────
+const dwellMs = (i) => (60000 / wpmAt(i)) * mults[i];
+const bounds = [];
+let idx = 0;
+for (const seg of segments) {
+    const marked = seg.text.replace(/\r\n?/g, '\n').replace(/\n[ \t]*\n+/g, ' [P] ').trim();
+    const count = marked ? marked.split(/\s+/).filter((w) => w !== '[P]').length : 0;
+    bounds.push([idx, idx + count]);
+    idx += count;
+}
+const seconds = bounds.map(([a, b]) => {
+    let ms = 0;
+    for (let i = a; i < b; i++) ms += dwellMs(i);
+    return ms / 1000;
+});
+const total = seconds.reduce((x, y) => x + y, 0);
+const rampS = seconds[1];
+console.log(`    beats: hold ${seconds[0].toFixed(1)}s · ramp ${rampS.toFixed(1)}s · payoff ${seconds[2].toFixed(1)}s · handoff ${seconds[3].toFixed(1)}s · total ${total.toFixed(1)}s`);
+if (rampS < 25 || rampS > 40) fail(`ramp lasts ${rampS.toFixed(1)}s, wanted about 30 (25-40)`);
+else ok(`ramp lasts ${rampS.toFixed(1)}s`);
+if (total > 150) fail(`the whole intro runs ${total.toFixed(0)}s; keep it under two and a half minutes`);
+
+// ── 4. Display rules for a one-word-at-a-time reader ────────────────────
+for (const t of parsed.tokens) {
+    const letters = t.word.replace(/[^A-Za-z0-9’']/g, '');
+    if (letters.length === 0) fail(`bare punctuation token "${t.word}" at ${t.id}`);
+    if (letters.length > 13) fail(`"${t.word}" (${letters.length} letters) is too long for the reel`);
+    if (/[—–…]/.test(t.word)) fail(`"${t.word}" carries a dash or ellipsis`);
+}
+const segText = (k) => segments[k].text;
+if (!/\b200\b/.test(segText(0))) fail('the opening beat should name 200');
+if (/\b300\b/.test(segText(1))) fail('the ramp beat must not reveal 300');
+if (!/\b300\b/.test(segText(2)) || !/\b200\b/.test(segText(2))) fail('the payoff must name both 200 and 300');
+if (/\bWPM\b/.test(segText(0))) fail('no "WPM" jargon in the opening beat');
+
+if (failures > 0) {
+    console.error(`\n${failures} intro check(s) failed.`);
+    process.exit(1);
+}
+console.log('ok  intro tutorial checks pass');
